# Credenciales de Cloudinary (gratis en https://cloudinary.com)
# Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Carpeta dentro de Cloudinary donde se guardaran las imagenes subidas
UPLOAD_FOLDER=bulk-uploads

# Puerto en el que corre el servidor
PORT=3000

# Origen(es) permitidos para CORS, separados por coma. Usa "*" para permitir cualquiera.
ALLOWED_ORIGINS=*
